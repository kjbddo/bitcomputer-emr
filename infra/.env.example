# BitComputer 환경 변수 예시.
#
# 이 파일은 커밋되고 `.env` 는 커밋되지 않는다. `.env` 에 키를 추가·삭제할
# 때는 같은 커밋에서 이 파일도 고친다 — 키가 여기 빠지면 다른 환경에서
# 조용히 기본값으로 떨어진다.
#
# 값 규칙
#   비어 있는 항목  노출되면 안 되는 값이다. 직접 채운다
#   값이 적힌 항목  그대로 두면 동작하는 기본값이다
#   `# a | b | c`   바로 아래 키가 받는 유효값 목록이다
#
# 시작하려면: `cp .env.example .env` 후 빈 항목을 채운다.
# 반드시 채워야 도커 스택이 뜨는 것: MYSQL_ROOT_PASSWORD, MYSQL_PASSWORD,
# ARANGO_PASSWORD, RABBITMQ_ERLANG_COOKIE, JWT_SECRET, LLM_API_KEY.

# ── Database ─────────────────────────────────────────────
# MySQL 컨테이너의 root 비밀번호. 컨테이너 최초 기동 때 이 값으로 초기화되며,
# 이후 바꾸려면 볼륨(infra_mysql-data)을 지워야 한다.
MYSQL_ROOT_PASSWORD=
# 업무 스키마 이름. 마스터 코드 적재 스크립트도 이 이름을 본다.
MYSQL_DATABASE=bitcomputer
# Spring 이 접속할 계정. 개발 스택은 root 를 그대로 쓴다.
MYSQL_USER=root
# MYSQL_USER 의 비밀번호. root 를 쓰면 MYSQL_ROOT_PASSWORD 와 같은 값을 넣는다.
MYSQL_PASSWORD=

# ── ArangoDB ─────────────────────────────────────────────
# ArangoDB root 비밀번호. MySQL 과 마찬가지로 최초 기동 때 고정된다.
ARANGO_PASSWORD=
# 처방 추천 그래프(방문·상병·처방·특이사항). packages/graph-etl 이 여기 적재한다.
ARANGO_DATABASE=bitcomputer_graph
# X-ray 그래프(사례·소견·ROI·벡터 인덱스). 위와 별개 DB 다.
XRAY_ARANGO_DATABASE=xray_graph_db

# ── RabbitMQ ─────────────────────────────────────────────
# guest/guest 는 RabbitMQ 개발용 기본 계정이다. 호스트 밖에서 접근 가능한 배포에서는 반드시 변경한다.
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
# 노드 간 인증에 쓰는 공유 비밀. 단일 노드에서도 필수이며 비면 기동에 실패한다.
#   openssl rand -hex 32
RABBITMQ_ERLANG_COOKIE=

# ── Auth ─────────────────────────────────────────────────
# HS512 서명에 쓰이므로 64바이트 이상이어야 한다.
#   openssl rand -base64 64
JWT_SECRET=
# 쉼표로 구분한 허용 Origin 목록
CORS_ALLOWED_ORIGINS=http://localhost:3000

# 최초 SUPER_USER(username: admin) 비밀번호.
# 비워 두면 계정을 만들지 않는다. 역할 부여 주체가 필요할 때만 채운다.
BOOTSTRAP_SUPERUSER_PASSWORD=
# access token 쿠키의 Secure 플래그. HTTPS 배포에서는 반드시 true 로 바꾼다.
# true | false
AUTH_COOKIE_SECURE=false

# ── LLM 모드 ─────────────────────────────────────────────
# 호출 서비스가 게이트웨이를 칠지, 내부 stub 으로 답할지.
# stub 은 결정론적 고정 응답이라 CI 와 테스트가 이 값을 쓴다.
# 아래 LLM_UPSTREAM_PROVIDER(게이트웨이가 어느 회사 API 를 치는가)와는
# 다른 축이다. 둘을 헷갈리지 않는다.
# real | stub
LLM_PROVIDER=real

# ── 아래 다섯은 프로덕션 경로에서 쓰이지 않는다 ─────────────────
# B0 에서 모든 프로덕션 LLM 호출이 게이트웨이 경유로 바뀌었다. 여기 남은
# 것은 평가·CLI 도구 전용이거나 이미 죽은 경로다. 비워 두면 그 도구만
# 못 쓰고 스택은 정상 동작한다.

# 진단서 평가(`/api/agent/document/evaluate`)가 Gemini 를 직접 호출한다.
# 그 화면(`/evaluation`)은 어디서도 링크되지 않는 내부 벤치마크 도구이고,
# 키가 폐기돼 현재 죽어 있다. 되살리려면 발급 후 여기 채운다.
GEMINI_API_KEY=
# services/prescription 의 CLI 도구(run_graph_qa.py, run_prescription_agent.py)와
# 평가 스크립트가 읽는다. `if __name__ == "__main__"` 아래에만 있어 API 경로에서는
# 죽은 코드다.
GOOGLE_API_KEY=
# 평가 시나리오 생성 스크립트 전용(services/*/evals/). 게이트웨이와 무관하게
# OpenAI 를 직접 친다.
OPENAI_API_KEY=
# 위 GOOGLE_API_KEY 를 쓰는 CLI 도구의 모델 ID.
GEMINI_MODEL=gemini-2.5-flash
# 읽는 코드가 저장소에 없다. 이력으로만 남아 있다.
OPENAI_MODEL=gpt-5-nano

# ── LLM 게이트웨이 ────────────────────────────────────────────
# 게이트웨이가 상류에 쓰는 유일한 자격증명. **이 저장소에서 프로덕션 LLM
# 호출에 실제로 쓰이는 키는 이것 하나다.** 호출 서비스들은 키를 모르고
# 게이트웨이 URL 만 안다.
# LLM_UPSTREAM_PROVIDER=bedrock 이면 이 값 대신 LLM_BEDROCK_API_KEY 를 쓴다.
LLM_API_KEY=
# LLM_UPSTREAM_PROVIDER=openai 일 때의 상류 주소. OpenAI 호환 프록시를
# 거친다면 여기를 바꾼다.
LLM_UPSTREAM_BASE_URL=https://api.openai.com/v1
# 게이트웨이가 상류에 실어 보내는 모델 ID.
LLM_MODEL=gpt-5.6-luna
# none | low | medium | high | xhigh | max
LLM_REASONING_EFFORT=low
# 게이트웨이 상류(Bedrock) 호출 1회 시도당 타임아웃. 3회 시도(최초 1 + 재시도
# 2) + backoff(0.5s+1.0s) 의 최악 케이스가 LLM_GATEWAY_TIMEOUT_SECONDS 보다
# 짧아야 재시도 2·3회차가 호출자에게 관측된다 — 45s 기준 3*45+1.5=136.5s <
# 180s. 이 값을 올릴 때는 LLM_GATEWAY_TIMEOUT_SECONDS 도 함께 검토한다.
LLM_TIMEOUT_SECONDS=45
# 상류 호출 재시도 횟수(최초 1회 + 재시도 N). 위 타임아웃 계산의 3회는
# 이 값이 2 라는 전제다 — 늘리면 총 예산도 다시 계산한다.
LLM_MAX_RETRIES=2
# 게이트웨이가 호출당 비용을 계측 레코드에 남길 때 쓰는 100만 토큰당 단가.
# 과금에 쓰이지 않는다 — X-LLM-Caller 별 비용을 눈으로 보기 위한 값이다.
# OpenAI 공개 단가(gpt-5.6-luna, 2026-08 기준). 변동하므로 하드코딩하지 않는다.
LLM_INPUT_PRICE_PER_1M=0.20
LLM_OUTPUT_PRICE_PER_1M=1.20
# 게이트웨이가 어느 회사의 API 를 치는가. 위쪽 LLM_PROVIDER(real|stub)와는
# 다른 축이다 — 그쪽은 호출 서비스가 게이트웨이를 쓸지 내부 stub 을 쓸지다.
# 이 값을 바꾸면 상류 URL·인증·파라미터 규칙·모델 ID 가 함께 바뀐다.
# openai | bedrock
LLM_UPSTREAM_PROVIDER=openai
# 아래 LLM_BEDROCK_* 는 LLM_UPSTREAM_PROVIDER=bedrock 일 때만 쓰인다.
# Bedrock 의 OpenAI 호환 경로는 Bedrock API 키(베어러)만 받는다 — SigV4 요청
# 서명은 이 경로에 쓸 수 없다. 장기 키는 만료일이 있고 단기 키는 최대 12시간이므로
# 만료는 401/403 으로 나타난다(계측 레코드의 upstreamStatus 로 관측).
LLM_BEDROCK_API_KEY=
# 계정마다 다르므로 기본값을 두지 않는다. 비어 있으면 제공자가 구성되지 않고
# 모든 요청이 503 이 되며, 계측에 provider=unresolved 로 남는다.
LLM_BEDROCK_REGION=
# bedrock-runtime | bedrock-mantle
LLM_BEDROCK_ENDPOINT=bedrock-runtime
# bedrock-runtime 에서 luna 는 In-Region 추론이 없다 — 교차 리전 추론 프로파일
# ID 를 써야 한다(us. / global. / in.). bedrock-mantle 로 바꾸면 반대로 베어 ID
# `openai.gpt-5.6-luna` 를 쓴다.
LLM_BEDROCK_MODEL=global.openai.gpt-5.6-luna
# 비우면 LLM_BEDROCK_REGION + LLM_BEDROCK_ENDPOINT 로 조립한다. 프록시나 VPC
# 엔드포인트를 거칠 때만 채운다.
LLM_BEDROCK_BASE_URL=
# 호출 서비스(prescription / certificate / validation-agent)가 게이트웨이를
# 찾는 주소. 컨테이너 네트워크 안의 이름이라 호스트에서 직접 돌릴 때는
# http://localhost:8003/v1 로 바꾼다.
LLM_GATEWAY_BASE_URL=http://llm-gateway:8003/v1
# 아래는 캐시가 아니라 서로 다른 두 계층의 타임아웃이다. 순서가 어긋나면
# 재시도가 호출자에게 절대 관측되지 않는다(최종 리뷰 IMPORTANT):
#   게이트웨이 총 예산(LLM_TIMEOUT_SECONDS 3회 시도 + backoff ≈ 136.5s)
#   < LLM_GATEWAY_TIMEOUT_SECONDS(prescription/certificate 가 게이트웨이
#     응답을 기다리는 총 시간, 180s)
#   = Java http.client.rest-template.read-timeout-ms(180000ms)
#   < apps/web DOCUMENT_API_TIMEOUT_MS(브라우저가 Java 를 기다리는 시간)
# validation-agent 는 이 서비스와 별개로 VALIDATION_LLM_TIMEOUT_SECONDS 를 쓴다
# (RabbitMQ 컨슈머 스레드가 걸리면 안 되므로 게이트웨이 총 예산과 별도로 관리).
LLM_GATEWAY_TIMEOUT_SECONDS=180
# 진단서 소견의 문장별 함의 판정을 2차 LLM 호출로 수행할지.
# 켜면 요청마다 게이트웨이 호출이 하나 더 붙는다. 비용은 X-LLM-Caller 가
# *-nli 로 분리돼 계측된다. spec §11 의 실측 전에는 off 로 둔다.
# off | on
LLM_VERIFICATION_NLI=off
# NLI 2차 호출의 총 예산. 재시도하지 않는다 — 게이트웨이 총예산(136.5s)에
# 이것이 더해져도 호출자 타임아웃(180s)을 넘지 않아야 한다.
LLM_VERIFICATION_NLI_TIMEOUT_SECONDS=30
# validation-agent 가 게이트웨이 응답을 기다리는 시간. RabbitMQ 컨슈머
# 스레드가 걸리면 안 되므로 위 게이트웨이 총 예산과 별도로 관리한다.
VALIDATION_LLM_TIMEOUT_SECONDS=180
# validation-agent 작업 하나의 전역 예산(초). 각 구간이 자기 타임아웃만 알던
# 상태에서는 합계가 25분을 넘을 수 있었다(리뷰 F-H7).
# RabbitMQ 하트비트 주기(60s)의 두 배 = 브로커가 연결을 닫는 문턱(120s) 보다
# 작아야 한다. 예산을 넘기면 작업을 죽이지 않고, 지금까지 모은 관측값으로
# 규칙 기반 판정을 내고 실행하지 않은 단계를 트레이스에 남긴다.
VALIDATION_JOB_BUDGET_SECONDS=110
# validation-agent -> prescription-api 호출(RAG 조회) 타임아웃.
# prescription-api 자신의 게이트웨이 총 예산(LLM_GATEWAY_TIMEOUT_SECONDS)
# 보다 짧으면 안 된다 — 짧으면 prescription-api 가 여전히 응답을 만드는
# 도중에 이 호출이 먼저 포기해 fallback 으로 잘못 기록된다.
PRESCRIPTION_AGENT_TIMEOUT_SECONDS=180

# ── X-ray engine ─────────────────────────────────────────
# 어느 서비스가 X-ray 분석을 맡는가. xray 는 services/xray-rag(검색·그래프),
# flask 는 services/radiology-legacy(구 단일 추론 API).
# xray | flask
RADIOLOGY_ENGINE=xray
# 촬영 방향 기본값. 검색은 같은 view 끼리만 비교하므로 적재된 데이터와
# 맞아야 한다.
# AP | PA
XRAY_API_DEFAULT_VIEW=PA

# 아래 세 토글은 "실제 모델을 시도하라"는 뜻이지 "실제 모델이다"가 아니다.
# 가중치를 못 올리면 각각 mock 으로 내려가고, 그 사실이 engineStatus /
# roi_status 에 그대로 보고된다 — 조용히 real 인 척하지 않는다.
# true | false
# SQUID 재구성 이상탐지. 가중치는 services/radiology-legacy/squid_exp1_256_mask.
USE_TORCH_ANOMALY=true
# DenseNet121 임베딩. torchvision 사전학습 가중치를 쓴다.
USE_TORCH_EMBEDDING=true
# ChestX-Det PSPNet 해부학 ROI 분할(폐·심장). 끄면 고전 CV 분할로 내려간다.
# 기본값이 false 인 이유: CPU 에서 분할 한 번에 18~32초가 걸려 추론 전체가
# 90초가 된다. 껐을 때는 1.3초다. 그 대가로 얻는 것이 없다 - EVALUATION.md
# 11.3 에서 다수 라벨 기준선을 넘지 못했다(top-1 은 표준오차 안, top-3 는
# 기준선 아래). GPU(T4 급)가 붙으면 2~4초가 되므로 그때 true 로 켠다.
#
# 이 값을 바꾸면 마스크가 달라진다. 저장된 ROI 임베딩과 질의가 서로 다른
# 해부 기준을 비교하게 되므로, 바꾼 뒤에는 재시드해야 한다.
USE_PSPNET_ROI=false

# xray-rag 벡터 차원. Arango 벡터 인덱스 차원과 반드시 같아야 한다.
# DenseNet121 pooled feature = 1024. 바꾸면 저장된 벡터가 전부 무효가 된다.
EMBEDDING_DIM=1024
# 비워 두면 실제로 구성된 임베딩 모델이 스스로 버전을 답한다. 값을 넣으면
# 그것으로 고정된다 - 모델과 어긋난 값을 넣으면 재색인 판단이 불가능해진다.
EMBEDDING_VERSION=
# torchvision 사전학습 가중치 캐시(호스트). 컨테이너에 egress 가 없어
# 런타임 다운로드가 안 되므로 이 경로를 마운트해 쓴다.
TORCH_CACHE_DIR=~/.cache/torch
# 아래 둘은 이름이 비슷하지만 **다른 쪽 파일시스템**을 가리킨다. 섞으면
# 마운트가 빈 디렉터리를 물어 PSPNet 이 조용히 CV 분할로 내려간다.
#
# 컨테이너 **안**에서 어댑터가 가중치를 찾는 경로. 비워 두면 compose 가
# 마운트 지점(/root/.torchxrayvision/models_data)을 기본값으로 넣는다.
# 비워 두는 것이 정상이다 — 마운트 경로를 바꿀 때만 함께 바꾼다.
PSPNET_CACHE_DIR=
# **호스트**의 가중치 위치. compose 가 위 마운트 지점에 read-only 로 건다.
# torchxrayvision 은 ~/.cache 가 아니라 홈 바로 아래에 받는다.
# 받는 법은 Docs/07-runbook-data-loading.md §5.7 참조.
PSPNET_HOST_CACHE_DIR=~/.torchxrayvision/models_data

# CheXpert 데이터셋 다운로드용 Kaggle 자격증명(kagglehub).
# 토큰 값을 그대로 넣거나, 토큰이 담긴 파일 경로를 넣어도 된다.
# kagglehub 는 이것을 ~/.kaggle/kaggle.json 보다 먼저 읽는다.
# 발급: Kaggle 계정 페이지 -> Settings -> API -> Create New Token
# 적재는 컨테이너가 아니라 호스트에서 돌므로, compose 가 아니라 셸에 실어야 한다:
#   export KAGGLE_API_TOKEN="$(grep '^KAGGLE_API_TOKEN=' infra/.env | cut -d= -f2-)"
KAGGLE_API_TOKEN=

# ── Front-End ────────────────────────────────────────────
# 프론트 설정 값은 여기 없다.
#
# 예전에는 NEXT_PUBLIC_API_BASE_URL 이 있었다. NEXT_PUBLIC_ 접두가 붙은 값은
# 빌드 시점에 번들에 박히므로, 값이 다른 만큼 프론트 이미지가 갈라졌다 -
# 도메인마다 하나, DR 용으로 또 하나.
#
# 지금은 브라우저가 API 를 상대 경로로 부르고, Next 가 `/api/*` 를 Spring 으로
# 넘긴다(apps/web/next.config.ts). 목적지는 compose 서비스 이름 `spring-boot` 으로
# 고정돼 있어 환경마다 다를 값이 없다.
