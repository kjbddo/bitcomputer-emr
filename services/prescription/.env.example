# prescription_api.py / run_prescription_agent.py 가 읽는 환경변수 템플릿.
# 복사해서 .env 로 저장 후 실제 값으로 채우세요 (git ignore 대상).

# Google Gemini API 키 (https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=

# (선택) Gemini 모델 기본값. 미지정 시 gemini-2.5-flash-lite.
# GEMINI_MODEL=gemini-2.5-flash-lite
# GEMINI_TEMPERATURE=0.0

# (선택) FastAPI 바인딩. 기본 0.0.0.0:8001.
# PRESCRIPTION_API_HOST=0.0.0.0
# PRESCRIPTION_API_PORT=8001

# (선택) ArangoDB 연결. 비우면 Back-End/src/main/resources/application-local.properties 의
# arangodb.* 값을 읽는다.
# ARANGO_HOST=127.0.0.1
# ARANGO_PORT=8529
# ARANGO_USER=root
# ARANGO_PASSWORD=
# ARANGO_DATABASE=bitcomputer_graph
